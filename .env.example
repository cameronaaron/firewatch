# Application Settings
APP_NAME=Firewatch
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./firewatch.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/firewatch
DATABASE_ECHO=false

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Fire Data API
CALFIRE_API_URL=https://incidents.fire.ca.gov/umbraco/api/IncidentApi/List
FIRE_DATA_FETCH_INTERVAL=600
FIRE_DATA_TIMEOUT=10
MAX_FIRE_DISTANCE_MILES=300.0
FIRE_STALE_HOURS=6

# Satellite and Remote Sensing
FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_API_TIMEOUT=20
FIRMS_SOURCE_IDS=["VIIRS_NOAA21_NRT","VIIRS_NOAA20_NRT","VIIRS_SNPP_NRT","MODIS_NRT"]
SATELLITE_SAMPLE_RADIUS_PIXELS=16
HMS_SMOKE_KML_BASE_URL=https://satepsanone.nesdis.noaa.gov/pub/FIRE/web/HMS/Smoke_Polygons/KML
HMS_SMOKE_LOOKBACK_DAYS=3
HMS_SMOKE_TIMEOUT=20
HMS_SMOKE_MAX_DISTANCE_MILES=25.0
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AIR_QUALITY_TIMEOUT=10
AIRNOW_API_KEY=your_airnow_api_key_here
AIRNOW_BASE_URL=https://www.airnowapi.org/aq/observation/latLong/current/
AIRNOW_RADIUS_MILES=25
HISTORICAL_BENCHMARK_MIN_SAMPLES=6
SPREAD_MODEL_PROMOTION_MIN_IMPROVEMENT_PCT=1.0
SPREAD_MODEL_PROMOTION_REQUIRE_INFORMATIVE=true
SPREAD_MODEL_PROMOTION_MIN_GROUPS=4
SPREAD_MODEL_PROMOTION_MIN_R2=0.0
SPREAD_MODEL_PROMOTION_MAX_MAE_STD_RATIO=0.65
SPREAD_MODEL_PROMOTION_MIN_STABILITY_SCORE=0.6
SPREAD_MODEL_PROMOTED_PATH=./artifacts/promoted_spread_model.joblib
SPREAD_MODEL_BOOTSTRAP_PROMOTION_ENABLED=false
SPREAD_MODEL_RUNTIME_ENSEMBLE_ENABLED=false
SPREAD_MODEL_RUNTIME_ENSEMBLE_MAX_MAE_DELTA_PCT=3.0

# Evacuation Distances (miles)
EVACUATION_DISTANCE_MONITOR=5.0
EVACUATION_DISTANCE_PREPARE=3.0
EVACUATION_DISTANCE_WARNING=2.0
EVACUATION_DISTANCE_EVACUATE=1.0

# Geocoding
GEOCODER_USER_AGENT=firewatch-app
GEOCODER_TIMEOUT=10
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current

# Caching
CACHE_TTL_SECONDS=300
HISTORICAL_DATA_RETENTION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
